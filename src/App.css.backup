/* Navigation Bar */
.navbar {
  background: rgba(15, 12, 41, 0.95);
  backdrop-filter: blur(10px);
  padding: 1rem 2rem;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  box-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);
}

.nav-container {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
}

.logo {
  font-size: 1.8rem;
  font-weight: bold;
  background: linear-gradient(135deg, #fff, #a855f7);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.nav-links {
  display: flex;
  gap: 1.5rem;
  list-style: none;
  flex-wrap: wrap;
}

.nav-btn {
  background: none;
  border: none;
  color: white;
  font-size: 1rem;
  cursor: pointer;
  padding: 0.5rem 1rem;
  transition: all 0.3s;
  border-radius: 8px;
  font-weight: 500;
}

.nav-btn:hover {
  background: rgba(168, 85, 247, 0.3);
  transform: translateY(-2px);
}

/* Hero Section with 3D Name */
.hero-section {
  min-height: 100vh;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-top: 60px;
}
.RotatingNameDiv{
  margin-top: 110px;
  padding-top: 110px;
}

.hero-content {
  text-align: center;
  z-index: 10;
}

#canvas-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.hero-text {
  position: relative;
  z-index: 2;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(10px);
  padding: 2rem;
  border-radius: 30px;
  border: 1px solid rgba(168, 85, 247, 0.5);
  animation: fadeInUp 1s ease-out;
}

.hero-text h1 {
  font-size: 4rem;
  margin-bottom: 1rem;
  background: linear-gradient(135deg, #a855f7, #e879f9, #60a5fa);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  animation: glow 3s ease-in-out infinite;
}

.hero-text p {
  font-size: 1.3rem;
  color: #e2e8f0;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(50px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes glow {
  0%, 100% {
    text-shadow: 0 0 20px rgba(168, 85, 247, 0.5);
  }
  50% {
    text-shadow: 0 0 40px rgba(168, 85, 247, 0.8), 0 0 60px rgba(232, 121, 249, 0.5);
  }
}

/* Main Container */
.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 2rem 2rem 2rem 2rem;
  position: relative;
  z-index: 2;
}

/* Cards */
.card {
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(10px);
  border-radius: 20px;
  padding: 2rem;
  margin-bottom: 2rem;
  border: 1px solid rgba(255, 255, 255, 0.1);
  transition: transform 0.3s, box-shadow 0.3s;
}

.card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 30px rgba(168, 85, 247, 0.2);
  border-color: rgba(168, 85, 247, 0.5);
}

.section-title {
  font-size: 2rem;
  margin-bottom: 1.5rem;
  color: #a855f7;
  border-left: 4px solid #a855f7;
  padding-left: 1rem;
}

/* Profile Section */
.profile-wrapper {
  display: flex;
  flex-wrap: wrap;
  gap: 2rem;
  align-items: center;
  justify-content: center;
}

.avatar {
  width: 200px;
  height: 200px;
  border-radius: 50%;
  object-fit: cover;
  border: 4px solid #a855f7;
  box-shadow: 0 0 20px rgba(168, 85, 247, 0.4);
}

.avatar-placeholder {
  width: 200px;
  height: 200px;
  border-radius: 50%;
  background: linear-gradient(135deg, #a855f7, #7c3aed);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 5rem;
  font-weight: bold;
  color: white;
  border: 4px solid #a855f7;
}

.intro h1 {
  font-size: 2.5rem;
  margin-bottom: 0.5rem;
}

.job-title {
  font-size: 1.3rem;
  color: #a855f7;
  margin-bottom: 1rem;
}

.contact-info {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-top: 1rem;
}

.contact-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: rgba(255, 255, 255, 0.1);
  padding: 0.5rem 1rem;
  border-radius: 20px;
  font-size: 0.9rem;
}

/* Skills Grid */
.skills-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 1rem;
}

.skill-category {
  background: rgba(0, 0, 0, 0.3);
  padding: 1rem;
  border-radius: 12px;
}

.skill-category h3 {
  color: #a855f7;
  margin-bottom: 0.5rem;
}

.skill-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 0.5rem;
}

.skill-tag {
  background: rgba(168, 85, 247, 0.2);
  padding: 0.3rem 0.8rem;
  border-radius: 15px;
  font-size: 0.85rem;
}

/* Certificates */
.certificates-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 1.5rem;
}

.cert-card {
  background: rgba(0, 0, 0, 0.3);
  padding: 1rem;
  border-radius: 12px;
  cursor: pointer;
  transition: all 0.3s;
  text-align: center;
  width: 180px;
}

.cert-card:hover {
  transform: scale(1.05);
  background: rgba(168, 85, 247, 0.3);
}

.cert-icon {
  font-size: 3rem;
  margin-bottom: 0.5rem;
}

.cert-name {
  font-size: 0.9rem;
}

/* Modal for Certificates */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
  animation: fadeIn 0.3s;
}

.modal-content {
  max-width: 90%;
  max-height: 90%;
  background: #1a1a2e;
  border-radius: 20px;
  padding: 1rem;
  position: relative;
}

.modal-content img {
  max-width: 100%;
  max-height: 80vh;
  border-radius: 12px;
}

.close-modal {
  position: absolute;
  top: -40px;
  right: 0;
  background: #a855f7;
  border: none;
  color: white;
  font-size: 1.5rem;
  cursor: pointer;
  padding: 0.5rem 1rem;
  border-radius: 8px;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* Timeline for Education & Experience */
.timeline-item {
  margin-bottom: 1.5rem;
  padding-left: 1rem;
  border-left: 2px solid #a855f7;
}

.timeline-title {
  font-size: 1.2rem;
  font-weight: bold;
}

.timeline-subtitle {
  color: #a855f7;
  font-size: 0.9rem;
  margin: 0.3rem 0;
}

.timeline-date {
  font-size: 0.8rem;
  opacity: 0.7;
  margin-bottom: 0.5rem;
}

/* Footer */
.footer {
  background: rgba(15, 12, 41, 0.95);
  padding: 2rem;
  margin-top: 3rem;
  text-align: center;
  border-top: 1px solid rgba(168, 85, 247, 0.3);
}

.social-links {
  display: flex;
  justify-content: center;
  gap: 2rem;
  margin-bottom: 1rem;
}

.social-link {
  color: white;
  font-size: 1.8rem;
  transition: all 0.3s;
}

.social-link:hover {
  color: #a855f7;
  transform: translateY(-3px);
}

.footer-text {
  font-size: 0.9rem;
  opacity: 0.7;
}

/* Responsive */
@media (max-width: 768px) {
  .nav-container {
    flex-direction: column;
    gap: 1rem;
  }
  
  .container {
    padding: 1rem 1rem 1rem 1rem;
  }
  
  .profile-wrapper {
    flex-direction: column;
    text-align: center;
  }
  
  .contact-info {
    justify-content: center;
  }
  
  .section-title {
    font-size: 1.5rem;
  }
  
  .hero-text h1 {
    font-size: 2rem;
  }
}
.margin_top{
  margin-top: 200px;
  font-weight: bold;
  background: linear-gradient(135deg, #a855f7, #e879f9, #60a5fa, #a855f7);
}
.Icon_Img{
  /* margin: 20px; */
  border-top: 15px;
  height: 40px;
  width: 40px;
  border-radius: 50%;
}
.Icon_Img_link{
  /* margin: 20px; */
  border: 15px;
  padding-top: 10px;
  margin-top: 10px;
  height: 40px;
  width: 40px;
  border-radius: 25%;
  color: whitesmoke;
  margin: 20px;

}
.Icon_Img_large{
  /* margin: 20px; */
  border-top: 15px;
  height: 100px;
  width: 100px;
  border-radius: 50%;
}
.social-links-icons-only {
  display: flex;
  justify-content: center;
  gap: 2rem;
  margin-bottom: 1rem;
}

.social-icon-link {
  color: white;
  font-size: 2rem;
  transition: all 0.3s;
  text-decoration: none;
  display: inline-block;
}

.social-icon-link:hover {
  color: #a855f7;
  transform: translateY(-3px) scale(1.1);
}
/*  */
/* Footer Social Icons Styles */
.social-icons-container {
  display: flex;
  justify-content: center;
  gap: 2rem;
  margin-bottom: 1.5rem;
  flex-wrap: wrap;
}

.footer-icon-link {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  color: white;
  text-decoration: none;
  transition: all 0.3s ease;
  font-size: 1.5rem;
}

.footer-icon-link:hover {
  color: #a855f7;
  transform: translateY(-5px);
}

.icon-label {
  font-size: 0.75rem;
  opacity: 0.8;
  font-weight: normal;
}

.footer-icon-link:hover .icon-label {
  opacity: 1;
  color: #a855f7;
}

/* Responsive for mobile */
@media (max-width: 768px) {
  .social-icons-container {
    gap: 1rem;
  }
  
  .footer-icon-link {
    font-size: 1.2rem;
  }
  
  .icon-label {
    font-size: 0.65rem;
  }
}
/* Languag section  */
.simple-language-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-top: 1rem;
}

.simple-language-item {
  background: rgba(0, 0, 0, 0.3);
  border-radius: 12px;
  padding: 0.8rem 1.2rem;
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
  transition: all 0.3s ease;
}

.simple-language-item:hover {
  transform: scale(1.02);
  background: rgba(168, 85, 247, 0.2);
}

.simple-flag {
  font-size: 1.5rem;
}

.simple-name {
  font-weight: bold;
  color: #a855f7;
}

.simple-level {
  color: #cbd5e1;
  font-size: 0.85rem;
}

.simple-stars {
  color: #fbbf24;
  font-size: 0.9rem;
  letter-spacing: 2px;
}
.profiles {
  background: rgba(15, 12, 41, 0.95);
  padding: 2rem;
  /* margin-top: 3rem; */
  margin-left: 8rem;
  margin-right: 8rem;
  text-align: center;
  border-top: 1px solid rgba(168, 85, 247, 0.3);
}
.profiles-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 1.5rem;
  margin-top: 1rem;
}

.profile-card {
  background: rgba(0, 0, 0, 0.3);
  border-radius: 15px;
  padding: 1.5rem;
  display: flex;
  align-items: center;
  gap: 1rem;
  text-decoration: none;
  transition: all 0.3s ease;
  border: 1px solid rgba(168, 85, 247, 0.2);
  position: relative;
  overflow: hidden;
}

.profile-card:hover {
  transform: translateY(-5px);
  border-color: rgba(168, 85, 247, 0.6);
  background: rgba(168, 85, 247, 0.1);
  box-shadow: 0 5px 20px rgba(168, 85, 247, 0.3);
}

.profile-card i {
  font-size: 3rem;
  color: #a855f7;
  transition: transform 0.3s ease;
}

.profile-card:hover i {
  transform: scale(1.1);
}

.profile-info {
  flex: 1;
}

.profile-info h3 {
  color: white;
  margin: 0 0 0.3rem 0;
  font-size: 1.1rem;
}

.profile-info p {
  color: #cbd5e1;
  margin: 0;
  font-size: 0.85rem;
}

.profile-arrow {
  color: #a855f7;
  font-size: 1.5rem;
  opacity: 0;
  transform: translateX(-10px);
  transition: all 0.3s ease;
}

.profile-card:hover .profile-arrow {
  opacity: 1;
  transform: translateX(0);
}

/* Specific icon colors on hover */
.profile-card:hover .fa-microsoft {
  color: #00a4ef;
}

.profile-card:hover .fa-hackerrank {
  color: #2ec866;
}

.profile-card:hover .fa-github {
  color: #ffffff;
}

.profile-card:hover .fa-linkedin {
  color: #0077b5;
}
.IconFooter{
  margin:  10px;
}
/* new idea */
/* Horizontal Certificates Carousel */
.carousel-container {
  position: relative;
  display: flex;
  align-items: center;
  gap: 1rem;
  margin: 1rem 0;
}

.certificates-scroll {
  display: flex;
  overflow-x: auto;
  scroll-behavior: smooth;
  gap: 1.5rem;
  padding: 1rem 0.5rem;
  scrollbar-width: thin;
  scrollbar-color: #a855f7 rgba(168, 85, 247, 0.2);
  flex: 1;
}

.certificates-scroll::-webkit-scrollbar {
  height: 8px;
}

.certificates-scroll::-webkit-scrollbar-track {
  background: rgba(168, 85, 247, 0.2);
  border-radius: 10px;
}

.certificates-scroll::-webkit-scrollbar-thumb {
  background: #a855f7;
  border-radius: 10px;
}

.certificates-scroll::-webkit-scrollbar-thumb:hover {
  background: #e879f9;
}

.cert-card-horizontal {
  min-width: 180px;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 15px;
  padding: 1.5rem;
  cursor: pointer;
  transition: all 0.3s ease;
  text-align: center;
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(168, 85, 247, 0.2);
  backdrop-filter: blur(10px);
}

.cert-card-horizontal:hover {
  transform: translateY(-10px) scale(1.02);
  border-color: #a855f7;
  box-shadow: 0 10px 30px rgba(168, 85, 247, 0.3);
}

.cert-card-horizontal .cert-icon {
  font-size: 3rem;
  margin-bottom: 0.8rem;
  transition: transform 0.3s ease;
}

.cert-card-horizontal:hover .cert-icon {
  transform: scale(1.1);
}

.cert-card-horizontal .cert-name {
  font-size: 0.9rem;
  font-weight: 500;
  color: white;
}

.cert-hover-effect {
  position: absolute;
  bottom: -30px;
  left: 0;
  right: 0;
  background: linear-gradient(135deg, #a855f7, #e879f9);
  padding: 8px;
  transition: bottom 0.3s ease;
  font-size: 0.7rem;
  color: white;
}

.cert-card-horizontal:hover .cert-hover-effect {
  bottom: 0;
}

.scroll-btn {
  background: rgba(168, 85, 247, 0.2);
  border: 1px solid rgba(168, 85, 247, 0.5);
  border-radius: 50%;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.3s ease;
  color: #a855f7;
  font-size: 1.2rem;
}

.scroll-btn:hover {
  background: #a855f7;
  color: white;
  transform: scale(1.1);
  box-shadow: 0 0 15px rgba(168, 85, 247, 0.5);
}

.scroll-btn:active {
  transform: scale(0.95);
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .cert-card-horizontal {
    min-width: 140px;
    padding: 1rem;
  }
  
  .cert-card-horizontal .cert-icon {
    font-size: 2rem;
  }
  
  .cert-card-horizontal .cert-name {
    font-size: 0.8rem;
  }
  
  .scroll-btn {
    width: 32px;
    height: 32px;
    font-size: 0.9rem;
  }
}
/* Circular Certificates Carousel */
.circular-container {
  position: relative;
  width: 100%;
  min-height: 500px;
  margin: 2rem 0;
  overflow: hidden;
}

.circular-carousel {
  position: relative;
  width: 100%;
  height: 500px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: grab;
  user-select: none;
}

.circular-carousel:active {
  cursor: grabbing;
}

.circular-items {
  position: relative;
  width: 450px;
  height: 450px;
  margin: 0 auto;
  transition: transform 0.1s ease-out;
}

.circular-item {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100px;
  height: 100px;
  margin-left: -50px;
  margin-top: -50px;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(10px);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.3s ease;
  border: 2px solid rgba(168, 85, 247, 0.3);
  box-shadow: 0 0 20px rgba(0, 0, 0, 0.3);
}

.circular-item:hover {
  transform: scale(1.1);
  border-color: #a855f7;
  box-shadow: 0 0 30px rgba(168, 85, 247, 0.5);
  background: rgba(168, 85, 247, 0.2);
}

.circular-item.active {
  border-color: #e879f9;
  box-shadow: 0 0 40px rgba(232, 121, 249, 0.6);
  background: rgba(168, 85, 247, 0.3);
  transform: scale(1.15);
}

.circular-icon {
  font-size: 2rem;
  transition: all 0.3s ease;
}

.circular-item:hover .circular-icon {
  transform: scale(1.1);
}

.circular-name {
  font-size: 0.7rem;
  text-align: center;
  margin-top: 5px;
  color: white;
  max-width: 80px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.circular-item.active .circular-name {
  color: #e879f9;
  font-weight: bold;
}

.circular-glow {
  position: absolute;
  top: -5px;
  left: -5px;
  right: -5px;
  bottom: -5px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(168,85,247,0.4), transparent);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 0.5;
    transform: scale(1);
  }
  50% {
    opacity: 1;
    transform: scale(1.05);
  }
}

.circular-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 150px;
  height: 150px;
  background: linear-gradient(135deg, rgba(168,85,247,0.2), rgba(0,0,0,0.6));
  backdrop-filter: blur(15px);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2px solid #a855f7;
  box-shadow: 0 0 50px rgba(168,85,247,0.3);
  z-index: 10;
  pointer-events: none;
}

.center-icon {
  font-size: 3rem;
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10px);
  }
}

.center-text {
  font-size: 0.85rem;
  text-align: center;
  margin-top: 10px;
  color: white;
  font-weight: bold;
  max-width: 120px;
}

.center-hint {
  font-size: 0.65rem;
  margin-top: 8px;
  color: #a855f7;
  opacity: 0.8;
}

.circular-controls {
  display: flex;
  justify-content: center;
  gap: 2rem;
  margin-top: 2rem;
  align-items: center;
}

.circular-nav-btn {
  background: rgba(168, 85, 247, 0.2);
  border: 1px solid #a855f7;
  padding: 8px 20px;
  border-radius: 25px;
  color: white;
  cursor: pointer;
  transition: all 0.3s ease;
  font-size: 0.9rem;
}

.circular-nav-btn:hover {
  background: #a855f7;
  transform: translateY(-2px);
  box-shadow: 0 5px 15px rgba(168,85,247,0.4);
}

.circular-counter {
  font-size: 1rem;
  color: #a855f7;
  font-weight: bold;
}

/* Responsive */
@media (max-width: 768px) {
  .circular-items {
    width: 300px;
    height: 300px;
  }
  
  .circular-item {
    width: 70px;
    height: 70px;
    margin-left: -35px;
    margin-top: -35px;
  }
  
  .circular-icon {
    font-size: 1.3rem;
  }
  
  .circular-name {
    font-size: 0.55rem;
    max-width: 60px;
  }
  
  .circular-center {
    width: 100px;
    height: 100px;
  }
  
  .center-icon {
    font-size: 2rem;
  }
  
  .center-text {
    font-size: 0.65rem;
    max-width: 80px;
  }
}
/* ============================================
   UNIFIED BORDER, PADDING & MARGIN STYLES
   ============================================ */

/* Unified card styles - all cards now have consistent spacing */
.card {
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(10px);
  border-radius: 20px;
  padding: 2rem;
  margin-bottom: 2rem;
  border: 1px solid rgba(168, 85, 247, 0.3);
  transition: all 0.3s ease;
}

.card:hover {
  border-color: rgba(168, 85, 247, 0.6);
  transform: translateY(-3px);
}

/* Unified section title */
.section-title {
  font-size: 1.8rem;
  margin-bottom: 1.5rem;
  color: #a855f7;
  border-left: 4px solid #a855f7;
  padding-left: 1rem;
}

/* Unified timeline items */
.timeline-item {
  margin-bottom: 1.5rem;
  padding: 0 0 0 1.2rem;
  border-left: 2px solid #a855f7;
}

/* Unified skill tags */
.skill-tag {
  background: rgba(168, 85, 247, 0.2);
  padding: 0.4rem 1rem;
  border-radius: 20px;
  font-size: 0.85rem;
  border: 1px solid rgba(168, 85, 247, 0.2);
  transition: all 0.3s ease;
}

.skill-tag:hover {
  border-color: #a855f7;
  transform: translateY(-2px);
}

/* Unified language items */
.simple-language-item {
  background: rgba(0, 0, 0, 0.3);
  border-radius: 12px;
  padding: 0.8rem 1.5rem;
  display: flex;
  align-items: center;
  gap: 1rem;
  border: 1px solid rgba(168, 85, 247, 0.2);
  transition: all 0.3s ease;
}

.simple-language-item:hover {
  border-color: #a855f7;
  transform: translateY(-2px);
  background: rgba(168, 85, 247, 0.1);
}

/* Unified profile cards */
.profile-card {
  background: rgba(0, 0, 0, 0.3);
  border-radius: 15px;
  padding: 1.2rem;
  display: flex;
  align-items: center;
  gap: 1rem;
  border: 1px solid rgba(168, 85, 247, 0.2);
  transition: all 0.3s ease;
}

.profile-card:hover {
  border-color: #a855f7;
  transform: translateY(-3px);
}

/* Unified circular items */
.circular-item {
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(10px);
  border-radius: 50%;
  border: 2px solid rgba(168, 85, 247, 0.3);
  transition: all 0.3s ease;
}

.circular-item:hover {
  border-color: #a855f7;
  transform: scale(1.1);
  background: rgba(168, 85, 247, 0.2);
}

/* Unified container padding */
.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 2rem;
  position: relative;
  z-index: 2;
}

/* Unified button styles */
.scroll-btn, .circular-nav-btn, .nav-btn {
  border-radius: 25px;
  padding: 0.5rem 1.2rem;
  transition: all 0.3s ease;
}

/* Unified spacing between sections */
section {
  scroll-margin-top: 80px;
}

/* Unified footer spacing */
.footer {
  padding: 2rem;
  margin-top: 3rem;
}
/* Modal Styles */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  animation: fadeIn 0.3s ease;
}

.modal-content {
  max-width: 90%;
  max-height: 90%;
  background: #1a1a2e;
  border-radius: 20px;
  padding: 1rem;
  position: relative;
  animation: slideIn 0.3s ease;
  border: 2px solid rgba(168, 85, 247, 0.5);
  box-shadow: 0 0 50px rgba(168, 85, 247, 0.3);
}

.modal-content img {
  max-width: 100%;
  max-height: 70vh;
  border-radius: 12px;
  object-fit: contain;
}

.modal-footer {
  text-align: center;
  margin-top: 1rem;
  padding-top: 0.8rem;
  border-top: 1px solid rgba(168, 85, 247, 0.3);
}

.modal-footer h3 {
  color: #a855f7;
  margin: 0 0 0.3rem 0;
  font-size: 1.1rem;
}

.modal-footer p {
  color: #cbd5e1;
  margin: 0;
  font-size: 0.8rem;
}

.close-modal {
  position: absolute;
  top: -40px;
  right: 0;
  background: #a855f7;
  border: none;
  color: white;
  font-size: 1.2rem;
  cursor: pointer;
  padding: 0.4rem 0.8rem;
  border-radius: 8px;
  transition: all 0.3s ease;
}

.close-modal:hover {
  background: #e879f9;
  transform: scale(1.05);
}

.modal-image {
  cursor: pointer;
  transition: transform 0.2s ease;
}

.modal-image:hover {
  transform: scale(1.02);
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
/* Statistics Section */
.stats-container {
  display: flex;
  justify-content: space-around;
  flex-wrap: wrap;
  gap: 2rem;
  text-align: center;
}

.stat-item {
  flex: 1;
  min-width: 120px;
}

.stat-number {
  font-size: 2.5rem;
  font-weight: bold;
  color: #a855f7;
  margin-bottom: 0.5rem;
}

.stat-label {
  font-size: 0.9rem;
  color: #cbd5e1;
}

/* Fun Facts */
.fun-facts-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1rem;
}

.fun-fact {
  background: rgba(0, 0, 0, 0.3);
  padding: 1rem;
  border-radius: 12px;
  display: flex;
  align-items: center;
  gap: 0.8rem;
  transition: all 0.3s ease;
  border: 1px solid rgba(168, 85, 247, 0.2);
}

.fun-fact:hover {
  transform: translateY(-3px);
  border-color: #a855f7;
}

.fun-icon {
  font-size: 1.8rem;
}

/* Featured Project */
.featured {
  background: linear-gradient(135deg, rgba(168,85,247,0.1), rgba(0,0,0,0.4));
  border: 2px solid #a855f7;
}

.featured-content {
  text-align: center;
  padding: 1rem;
}

.featured-content h3 {
  font-size: 1.5rem;
  color: #a855f7;
  margin-bottom: 1rem;
}

.featured-links {
  display: flex;
  gap: 1rem;
  justify-content: center;
  margin-top: 1rem;
}

.featured-links a {
  color: white;
  text-decoration: none;
  padding: 0.5rem 1.5rem;
  border-radius: 25px;
  background: rgba(168, 85, 247, 0.3);
  transition: all 0.3s ease;
}

.featured-links a:hover {
  background: #a855f7;
  transform: translateY(-2px);
}

/* Testimonials */
.testimonial-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.5rem;
}

.testimonial {
  background: rgba(0, 0, 0, 0.3);
  padding: 1.5rem;
  border-radius: 15px;
  border-left: 4px solid #a855f7;
}

.testimonial p {
  font-style: italic;
  margin-bottom: 1rem;
  line-height: 1.6;
}

.testimonial h4 {
  color: #a855f7;
  font-size: 0.9rem;
}

/* Tech Cloud */
.tech-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  justify-content: center;
  padding: 1rem;
}

.tech-badge {
  background: rgba(168, 85, 247, 0.2);
  padding: 0.5rem 1.2rem;
  border-radius: 30px;
  font-size: 0.9rem;
  transition: all 0.3s ease;
  border: 1px solid rgba(168, 85, 247, 0.3);
}

.tech-badge:hover {
  transform: scale(1.05);
  background: #a855f7;
  border-color: #a855f7;
}
/* Projects Grid - Matching Featured Project Style */
.projects-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 1.5rem;
  margin-top: 1rem;
}

.project-card {
  background: rgba(0, 0, 0, 0.3);
  border-radius: 15px;
  padding: 1.5rem;
  transition: all 0.3s ease;
  border: 1px solid rgba(168, 85, 247, 0.2);
  position: relative;
  overflow: hidden;
}

.project-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(168, 85, 247, 0.1), transparent);
  transition: left 0.5s ease;
}

.project-card:hover::before {
  left: 100%;
}

.project-card:hover {
  transform: translateY(-5px);
  border-color: #a855f7;
  box-shadow: 0 10px 30px rgba(168, 85, 247, 0.2);
  background: rgba(168, 85, 247, 0.05);
}

.project-card h3 {
  font-size: 1.3rem;
  color: #a855f7;
  margin-bottom: 0.8rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.project-card h3::before {
  content: '💻';
  font-size: 1.2rem;
}

.project-card p {
  color: #cbd5e1;
  font-size: 0.9rem;
  line-height: 1.5;
  margin-bottom: 1rem;
}

.project-links {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  margin-top: 0.5rem;
}

.project-links a {
  color: white;
  text-decoration: none;
  padding: 0.4rem 1rem;
  border-radius: 20px;
  background: rgba(168, 85, 247, 0.2);
  transition: all 0.3s ease;
  font-size: 0.8rem;
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
}

.project-links a:first-child::before {
  content: '📂';
}

.project-links a:last-child::before {
  content: '🔗';
}

.project-links a:hover {
  background: #a855f7;
  transform: translateY(-2px);
  box-shadow: 0 5px 15px rgba(168, 85, 247, 0.4);
}

/* Optional: Add different icons for different project types */
.project-card:nth-child(1) h3::before { content: '🌐'; }
.project-card:nth-child(2) h3::before { content: '🎮'; }
.project-card:nth-child(3) h3::before { content: '📐'; }
.project-card:nth-child(4) h3::before { content: '🎙️'; }
.project-card:nth-child(5) h3::before { content: '👾'; }
.project-card:nth-child(6) h3::before { content: '📊'; }

/* Responsive */
@media (max-width: 768px) {
  .projects-grid {
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  
  .project-card {
    padding: 1.2rem;
  }
  
  .project-card h3 {
    font-size: 1.1rem;
  }
}
/* ============================================
   ENHANCED FUN FACTS SECTION
   ============================================ */
.fun-facts-enhanced {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.5rem;
  margin-top: 1rem;
}

.fun-fact-card {
  background: rgba(0, 0, 0, 0.3);
  border-radius: 20px;
  padding: 1.5rem;
  display: flex;
  gap: 1rem;
  position: relative;
  overflow: hidden;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  border: 1px solid rgba(168, 85, 247, 0.2);
  animation: fadeInUp 0.6s ease forwards;
  opacity: 0;
  animation-delay: calc(var(--delay, 0) * 0.1s);
}

.fun-fact-card:hover {
  transform: translateY(-8px) scale(1.02);
  border-color: #a855f7;
  box-shadow: 0 15px 40px rgba(168, 85, 247, 0.3);
}

.fun-fact-icon {
  font-size: 2.5rem;
  transition: transform 0.3s ease;
}

.fun-fact-card:hover .fun-fact-icon {
  transform: scale(1.2) rotate(5deg);
}

.fun-fact-content {
  flex: 1;
}

.fun-fact-content h4 {
  color: #a855f7;
  font-size: 1.1rem;
  margin-bottom: 0.5rem;
}

.fun-fact-content p {
  color: #cbd5e1;
  font-size: 0.85rem;
  line-height: 1.4;
}

.language-bubbles, .learning-stack {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 0.8rem;
}

.language-bubbles span, .learning-stack span {
  background: rgba(168, 85, 247, 0.2);
  padding: 0.2rem 0.6rem;
  border-radius: 15px;
  font-size: 0.7rem;
  transition: all 0.3s ease;
}

.language-bubbles span:hover, .learning-stack span:hover {
  background: #a855f7;
  transform: scale(1.05);
}

.fun-fact-hover-effect {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: linear-gradient(90deg, #a855f7, #e879f9);
  transform: scaleX(0);
  transition: transform 0.4s ease;
}

.fun-fact-card:hover .fun-fact-hover-effect {
  transform: scaleX(1);
}

/* ============================================
   ENHANCED EDUCATION TIMELINE
   ============================================ */
.education-timeline-enhanced {
  position: relative;
  padding-left: 2rem;
}

.timeline-item-enhanced {
  position: relative;
  margin-bottom: 2rem;
  animation: slideInLeft 0.6s ease forwards;
  opacity: 0;
  animation-delay: calc(var(--i, 0) * 0.2s);
}

.timeline-dot {
  position: absolute;
  left: -2rem;
  top: 0;
  width: 40px;
  height: 40px;
  background: linear-gradient(135deg, #a855f7, #e879f9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
  box-shadow: 0 0 20px rgba(168, 85, 247, 0.5);
  transition: all 0.3s ease;
  z-index: 2;
}

.timeline-item-enhanced:hover .timeline-dot {
  transform: scale(1.2);
  box-shadow: 0 0 30px rgba(168, 85, 247, 0.8);
}

.timeline-line {
  position: absolute;
  left: -1.2rem;
  top: 40px;
  width: 2px;
  height: calc(100% + 1rem);
  background: linear-gradient(180deg, #a855f7, transparent);
}

.timeline-item-enhanced:last-child .timeline-line {
  display: none;
}

.timeline-content {
  background: rgba(0, 0, 0, 0.3);
  border-radius: 15px;
  padding: 1.2rem;
  transition: all 0.3s ease;
  border: 1px solid rgba(168, 85, 247, 0.2);
}

.timeline-content:hover {
  transform: translateX(10px);
  border-color: #a855f7;
  background: rgba(168, 85, 247, 0.05);
}

.timeline-year {
  display: inline-block;
  background: rgba(168, 85, 247, 0.3);
  padding: 0.2rem 0.8rem;
  border-radius: 20px;
  font-size: 0.7rem;
  margin-bottom: 0.5rem;
}

.timeline-content h3 {
  color: white;
  font-size: 1.1rem;
  margin-bottom: 0.3rem;
}

.timeline-content h4 {
  color: #a855f7;
  font-size: 0.85rem;
  margin-bottom: 0.5rem;
}

.timeline-content p {
  color: #cbd5e1;
  font-size: 0.85rem;
}

.timeline-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 0.8rem;
}

.timeline-badges .badge {
  background: rgba(168, 85, 247, 0.2);
  padding: 0.2rem 0.6rem;
  border-radius: 15px;
  font-size: 0.7rem;
  transition: all 0.3s ease;
}

.timeline-badges .badge:hover {
  background: #a855f7;
  transform: scale(1.05);
}

/* ============================================
   ENHANCED EXPERIENCE GRID
   ============================================ */
.experience-grid-enhanced {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 1.5rem;
  margin-top: 1rem;
}

.exp-card {
  background: rgba(0, 0, 0, 0.3);
  border-radius: 20px;
  padding: 1.2rem;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  border: 1px solid rgba(168, 85, 247, 0.2);
  position: relative;
  overflow: hidden;
  animation: fadeInUp 0.6s ease forwards;
  opacity: 0;
  animation-delay: calc(var(--d, 0) * 0.1s);
}

.exp-card:hover {
  transform: translateY(-8px);
  border-color: #a855f7;
  box-shadow: 0 15px 40px rgba(168, 85, 247, 0.2);
}

.exp-header {
  display: flex;
  gap: 1rem;
  margin-bottom: 1rem;
  flex-wrap: wrap;
}

.exp-icon {
  font-size: 2rem;
  transition: transform 0.3s ease;
}

.exp-card:hover .exp-icon {
  transform: scale(1.1) rotate(5deg);
}

.exp-title {
  flex: 1;
}

.exp-title h3 {
  color: white;
  font-size: 1rem;
  margin-bottom: 0.2rem;
}

.exp-title h4 {
  color: #a855f7;
  font-size: 0.8rem;
}

.exp-date {
  font-size: 0.7rem;
  color: #cbd5e1;
  background: rgba(168, 85, 247, 0.2);
  padding: 0.2rem 0.6rem;
  border-radius: 15px;
  height: fit-content;
}

.exp-body p {
  color: #cbd5e1;
  font-size: 0.85rem;
  line-height: 1.4;
  margin-bottom: 0.8rem;
}

.exp-skills {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.exp-skills span {
  background: rgba(168, 85, 247, 0.2);
  padding: 0.2rem 0.6rem;
  border-radius: 15px;
  font-size: 0.7rem;
  transition: all 0.3s ease;
}

.exp-skills span:hover {
  background: #a855f7;
  transform: translateY(-2px);
}

.exp-progress {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 3px;
  background: linear-gradient(90deg, #a855f7, #e879f9);
  transition: width 0.6s ease;
}

.exp-card:hover .exp-progress {
  width: 100%;
}

/* Animations */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideInLeft {
  from {
    opacity: 0;
    transform: translateX(-30px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* Set animation delays */
.fun-fact-card:nth-child(1) { --delay: 1; }
.fun-fact-card:nth-child(2) { --delay: 2; }
.fun-fact-card:nth-child(3) { --delay: 3; }
.fun-fact-card:nth-child(4) { --delay: 4; }

.timeline-item-enhanced:nth-child(1) { --i: 1; }
.timeline-item-enhanced:nth-child(2) { --i: 2; }
.timeline-item-enhanced:nth-child(3) { --i: 3; }

.exp-card:nth-child(1) { --d: 1; }
.exp-card:nth-child(2) { --d: 2; }
.exp-card:nth-child(3) { --d: 3; }
.exp-card:nth-child(4) { --d: 4; }